<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels" xmlns:models="clr-namespace:LifeManagementApp.Models"
             x:Class="LifeManagementApp.Views.TodoListPage" x:Name="Page" x:DataType="vm:TodoListViewModel" Title="To-dos">
    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <VerticalStackLayout Spacing="4">
            <Label Text="To-dos" FontSize="28" FontAttributes="Bold" />
            <Label Text="Keep the important things moving." Style="{StaticResource CaptionLabel}" />
        </VerticalStackLayout>
        <!-- Filtering and sorting are local view concerns over one repository snapshot. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Picker Title="All categories" SemanticProperties.Description="Filter tasks by category" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" ItemDisplayBinding="{Binding Name}" />
            <Picker Grid.Column="1" Title="Sort by" SemanticProperties.Description="Choose task sort order" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Placeholder="New category" SemanticProperties.Description="New category name" Text="{Binding NewCategoryName}" />
            <Button Grid.Column="1" Text="Add category" SemanticProperties.Description="Add a new task category" Command="{Binding AddCategoryCommand}" Style="{StaticResource SecondaryButton}" />
        </Grid>
        <HorizontalStackLayout Grid.Row="3" Spacing="6">
            <Button Text="{Binding HideDoneButtonText}" Command="{Binding ToggleHideDoneCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="Archive done" Command="{Binding ArchiveDoneCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="Delete done" Command="{Binding DeleteDoneCommand}" Style="{StaticResource DangerButton}" />
        </HorizontalStackLayout>
        <Label Grid.Row="4" Text="{Binding ErrorMessage}" TextColor="Red" />
        <CollectionView Grid.Row="5" ItemsSource="{Binding Items}" EmptyView="No tasks yet. Add one to get started.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button Grid.Column="0" Text="{Binding IsDone, Converter={StaticResource TaskCompletionTextConverter}}"
                                    Style="{StaticResource SecondaryButton}"
                                    SemanticProperties.Description="{Binding Title, StringFormat='Change completion for {0}'}"
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleDoneCommand, x:DataType=ContentPage}"
                                    CommandParameter="{Binding .}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding DueDate, StringFormat='Due {0:d}'}" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding Priority, StringFormat='Priority {0}/5'}" Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                <Button Text="Edit" Style="{StaticResource SecondaryButton}"
                                        SemanticProperties.Description="{Binding Title, StringFormat='Edit {0}'}"
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditCommand, x:DataType=ContentPage}" CommandParameter="{Binding .}" />
                                <Button Text="Delete" Style="{StaticResource DangerButton}"
                                        SemanticProperties.Description="{Binding Title, StringFormat='Delete {0}'}"
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteCommand, x:DataType=ContentPage}" CommandParameter="{Binding .}" />
                                <Button Text="{Binding Archived, Converter={StaticResource ArchiveTextConverter}}" Style="{StaticResource SecondaryButton}"
                                        SemanticProperties.Description="{Binding Title, StringFormat='Archive or unarchive {0}'}"
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.ArchiveCommand, x:DataType=ContentPage}" CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="6" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Text="{Binding ArchiveViewButtonText}" Command="{Binding ToggleArchivedViewCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="1" Text="Add a to-do" Command="{Binding AddCommand}" />
        </Grid>
    </Grid>
</ContentPage>
