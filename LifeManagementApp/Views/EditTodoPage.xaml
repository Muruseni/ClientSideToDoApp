<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:LifeManagementApp.ViewModels" x:Class="LifeManagementApp.Views.EditTodoPage" x:DataType="vm:EditTodoViewModel" Title="Edit to-do">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Edit to-do" FontSize="28" FontAttributes="Bold" />
        <Label Text="Title" /><Entry SemanticProperties.Description="To-do title" Text="{Binding Title}" />
        <Label Text="Priority (1–5)" /><Stepper Minimum="1" Maximum="5" Increment="1" Value="{Binding Priority}" />
        <Label Text="{Binding Priority, StringFormat='Priority: {0}'}" />
        <Label Text="Due date" /><DatePicker SemanticProperties.Description="To-do due date" Date="{Binding DueDate}" />
        <Label Text="{Binding ErrorMessage}" SemanticProperties.Description="Validation message" TextColor="Red" /><ActivityIndicator IsRunning="{Binding IsBusy}" /><Button Text="Save" SemanticProperties.Description="Save changes to this to-do" Command="{Binding SaveCommand}" />
    </VerticalStackLayout>
</ContentPage>
