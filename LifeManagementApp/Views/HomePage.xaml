<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             xmlns:models="clr-namespace:LifeManagementApp.Models"
             x:Class="LifeManagementApp.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home">
    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="Life Management" FontSize="28" FontAttributes="Bold" />
            <Label Text="A calm place for today’s priorities." Style="{StaticResource CaptionLabel}" />
        </VerticalStackLayout>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <Label Text="Weather" FontSize="20" FontAttributes="Bold" />
                <Button Grid.Column="1" Text="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding LoadWeatherCommand}" />
                <Entry Grid.Row="1" Placeholder="City" Text="{Binding City}" ReturnType="Search" />
                <Button Grid.Row="1" Grid.Column="1" Text="Get weather" Command="{Binding LoadWeatherCommand}" />
                <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsWeatherBusy}" />
                <Label Grid.Row="2" Grid.Column="1" Text="{Binding WeatherError}" TextColor="Red" />
                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="2">
                    <Label Text="{Binding Weather.Temperature, StringFormat='{0:0}°C'}" FontSize="30" FontAttributes="Bold" />
                    <Label Text="{Binding Weather.Description}" />
                    <Label Text="{Binding Weather.City, StringFormat='in {0}'}" Style="{StaticResource CaptionLabel}" />
                    <Label Text="{Binding Weather.FeelsLike, StringFormat='Feels like {0:0}°C'}" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        <Label Grid.Row="2" Text="Your next tasks" FontSize="20" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Items}" EmptyView="No open tasks yet. Add one from the To-dos tab.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Border StrokeThickness="1" Padding="12" Margin="0,0,0,8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding DueDate, StringFormat='Due: {0:d}'}" />
                            <Label Text="{Binding Priority, StringFormat='Priority: {0}'}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="4" Spacing="8">
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            <Button Text="Open all to-dos" Command="{Binding OpenTasksCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
