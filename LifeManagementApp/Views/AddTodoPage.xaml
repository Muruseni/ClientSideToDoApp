<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels" x:Class="LifeManagementApp.Views.AddTodoPage"
             x:DataType="vm:AddTodoViewModel" Title="Add to-do">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Add a to-do" FontSize="28" FontAttributes="Bold" />
        <Label Text="Title" /><Entry Placeholder="What needs doing?" SemanticProperties.Description="To-do title" Text="{Binding Title}" />
        <Label Text="Priority (1–5)" /><Stepper Minimum="1" Maximum="5" Increment="1" Value="{Binding Priority}" />
        <Label Text="{Binding Priority, StringFormat='Priority: {0}'}" />
        <Label Text="Category (optional)" />
        <Picker Title="Choose a category" SemanticProperties.Description="Optional to-do category" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" ItemDisplayBinding="{Binding Name}" />
        <Label Text="Due date" /><DatePicker SemanticProperties.Description="To-do due date" Date="{Binding DueDate}" />
        <Label Text="{Binding ErrorMessage}" TextColor="Red" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" />
        <Button Text="Save" SemanticProperties.Description="Save this to-do" Command="{Binding SaveCommand}" />
    </VerticalStackLayout>
</ContentPage>
